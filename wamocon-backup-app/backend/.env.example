# Backend Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ────────────────────────────────────────────────────────────────
# Option A: Supabase Session Pooler (IPv4, empfohlen für alle Plattformen)
# Region aus Supabase Dashboard: Connect → Session Pooler → URL kopieren
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Option B: Supabase direkte Verbindung (nur IPv6 — funktioniert nicht überall)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret for signing JWT tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example for Vercel: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ─── URBackup ────────────────────────────────────────────────────────────────
URBACKUP_SERVER_URL=http://192.168.1.100:55414
URBACKUP_USERNAME=admin
URBACKUP_PASSWORD=
URBACKUP_SYNC_SCHEDULE=*/15 * * * *

# ─── rclone ──────────────────────────────────────────────────────────────────
RCLONE_PATH=rclone
RCLONE_LOG_DIR=../logs

# ─── Mac Studio Agent ────────────────────────────────────────────────────────
MACSTUDIO_URL=http://192.168.178.62:9090
MACSTUDIO_API_KEY=

# ─── E-Mail Benachrichtigungen ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
