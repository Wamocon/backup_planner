# ══════════════════════════════════════════════════════════════════════════════
# WAMOCON Backup Backend — Environment Variables
# Kopiere diese Datei zu .env und passe die Werte an.
#
# LOKAL (Huawei Notebook / Entwicklung):
#   NODE_ENV=development
#   ALLOWED_ORIGINS=http://localhost:5173
#
# PRODUKTION (Mac Mini + Cloudflare Tunnel):
#   NODE_ENV=production
#   ALLOWED_ORIGINS=https://backup-planner.vercel.app
# ══════════════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Lokal: development | Mac Mini: production
NODE_ENV=development

# ─── Datenbank (Supabase PostgreSQL via Session Pooler) ──────────────────────
# Supabase Dashboard → Connect → Session Pooler → URL kopieren
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# Muss auf ALLEN Instanzen (lokal + Mac Mini) IDENTISCH sein!
JWT_SECRET=change-me-to-a-long-random-secret

# ─── CORS ────────────────────────────────────────────────────────────────────
# Lokal:    ALLOWED_ORIGINS=http://localhost:5173
# Mac Mini: ALLOWED_ORIGINS=https://backup-planner.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ─── URBackup Server ─────────────────────────────────────────────────────────
URBACKUP_URL=http://192.168.178.62:55414/
URBACKUP_USERNAME=admin
URBACKUP_PASSWORD=
URBACKUP_SYNC_SCHEDULE=*/15 * * * *

# ─── rclone ──────────────────────────────────────────────────────────────────
RCLONE_PATH=rclone
RCLONE_LOG_DIR=./data/logs

# ─── Mac Studio Agent ────────────────────────────────────────────────────────
MACSTUDIO_URL=http://192.168.178.62:9090
MACSTUDIO_API_KEY=

# ─── E-Mail Benachrichtigungen (optional) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
